# Wymuszenie ładowania index.html jako strony głównej
DirectoryIndex index.html

# Wyłączenie listowania plików w folderze (bezpieczeństwo)
Options -Indexes

# Wymuszenie HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Markdown for Agents (RFC 9110 content negotiation) — gdy klient prosi o text/markdown
# zwracamy odpowiednia wersje .md zamiast HTML. Domyslnie dla przegladarek bez zmian.
# WAZNE: te reguly MUSZA byc PRZED trailing-slash redirect, bo LiteSpeed
# przetwarza rewrite'y sekwencyjnie i trailing-slash lapie /index.md -> /index.md/ -> 404.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Strona glowna -> index.md (markdown wersja HTML, nie agent-context)
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^$ /index.md [L,T=text/markdown]

    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteRule ^en/?$ /en/index.md [L,T=text/markdown]

    # Podstrony HTML -> *.md (gdy plik istnieje)
    RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} \.html$
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} ^(.+)\.html$
    RewriteCond %1.md -f
    RewriteRule ^(.+)\.html$ /$1.md [L,T=text/markdown]
</IfModule>

# Zapobieganie błędom 403 przy braku slash na końcu URL
# Wyklucz pliki z rozszerzeniem (np. .md, .txt, .json) — dotycza bezposrednich zasobow.
<IfModule mod_rewrite.c>
    RewriteBase /
    RewriteCond %{HTTPS} =on
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
    RewriteCond %{REQUEST_URI} !(.*)\/$
    RewriteRule ^(.*)$ https://timeflow.conceptfab.com/$1/ [L,R=301]
</IfModule>

# Kompresja GZIP — zmniejsza transfer CSS/JS/HTML o ~75-80%
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/markdown
</IfModule>

# Cache statycznych assetów — powtórne wizyty bez ponownego pobierania
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|avif|webp|png|ico|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# Nagłówki bezpieczeństwa
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=86400; includeSubDomains" env=HTTPS
    Header always set X-Frame-Options "DENY"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com; frame-ancestors 'none'"
</IfModule>

# Link headers dla agentow AI (RFC 8288) — wskazuja zasoby do odkrycia.
# llms.txt/llms-full.txt jako sciezki relatywne, zeby /en/ wskazywal en/llms-*.txt.
# sitemap i agent-skills index sa globalne (sciezki absolutne z /).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|php)$">
        Header append Link "<llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        Header append Link "<llms-full.txt>; rel=\"alternate\"; type=\"text/markdown\"; title=\"AI agent context (Markdown for Agents)\""
        Header append Link "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
        Header append Link "</.well-known/agent-skills/index.json>; rel=\"https://agentskills.io/rel/index\"; type=\"application/json\""
        Header append Link "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\""
        Header append Link "</.well-known/mcp/server-card.json>; rel=\"https://modelcontextprotocol.io/rel/server-card\"; type=\"application/json\""
        Header append Link "</.well-known/oauth-protected-resource>; rel=\"https://datatracker.ietf.org/doc/html/rfc9728\"; type=\"application/json\""
        Header append Link "</.well-known/oauth-authorization-server>; rel=\"https://datatracker.ietf.org/doc/html/rfc8414\"; type=\"application/json\""
        Header append Link "</api/openapi.json>; rel=\"service-desc\"; type=\"application/vnd.oai.openapi+json;version=3.1\""
    </FilesMatch>
</IfModule>

# (Markdown for Agents rewrite przeniesiony wyzej — przed trailing-slash redirect)

# Wymus poprawny Content-Type i x-markdown-tokens dla zwracanych plikow .md
<IfModule mod_headers.c>
    <FilesMatch "\.md$">
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Vary "Accept"
    </FilesMatch>
    <FilesMatch "llms(-full)?\.txt$">
        Header set Content-Type "text/markdown; charset=utf-8"
        Header set Vary "Accept"
    </FilesMatch>
</IfModule>

# Mapowanie typu MIME dla .md (gdy mod_mime jest aktywny)
<IfModule mod_mime.c>
    AddType text/markdown .md
</IfModule>

# Content-Type dla /.well-known/api-catalog (RFC 9727 — application/linkset+json)
<IfModule mod_headers.c>
    <Files "api-catalog">
        Header set Content-Type "application/linkset+json; charset=utf-8"
        Header set Cache-Control "public, max-age=3600"
    </Files>
    # Content-Type dla /.well-known/oauth-protected-resource (RFC 9728)
    <Files "oauth-protected-resource">
        Header set Content-Type "application/json; charset=utf-8"
        Header set Cache-Control "public, max-age=3600"
    </Files>
    # Content-Type dla /.well-known/oauth-authorization-server (RFC 8414)
    <Files "oauth-authorization-server">
        Header set Content-Type "application/json; charset=utf-8"
        Header set Cache-Control "public, max-age=3600"
    </Files>
</IfModule>
